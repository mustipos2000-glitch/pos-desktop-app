{
  "name": "po-desktop",
  "version": "0.0.4",
  "description": "POS Desktop Application - Monorepo with React, Node.js, and Electron",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run rebuild:sqlite:node && concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:electron": "wait-on http://localhost:3000 http://localhost:5000 && npm run rebuild:sqlite:electron && electron .",
    "rebuild:sqlite:node": "npm rebuild better-sqlite3",
    "rebuild:sqlite:electron": "electron-rebuild -f -w better-sqlite3",
    "migrate": "node packages/server/migrate.js",
    "seed:terminals": "node packages/server/seed-terminals.js",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "clean": "rimraf dist packages/client/build",
    "postinstall": "npm run rebuild:sqlite",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "package:win": "npm run build && npm run rebuild && electron-builder",
    "build:electron": "npm run package:win",
    "start": "electron .",
    "test": "npm run test --workspaces"
  },
  "build": {
    "appId": "com.sohailkhan.po-desktop",
    "productName": "Point of Sale Application",
    "npmRebuild": true,
    "buildDependenciesFromSource": true,
    "files": [
      "electron/**/*",
      "packages/client/build/**/*",
      "packages/server/**/*",
      "!packages/server/uploads/**/*",
      "!packages/server/database.sqlite",
      "package.json",
      "database/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "packages/server/**/*",
      "packages/client/build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "author": "sohail & Rao",
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "concurrently": "^8.2.2",
    "electron": "38.2.2",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "rimraf": "^6.0.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "node-thermal-printer": "^4.5.0",
    "nodemailer": "^7.0.11",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0"
  }
}
