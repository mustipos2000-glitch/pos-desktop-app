{
  "name": "po-desktop",
  "version": "0.0.2",
  "description": "POS Desktop Application - Monorepo with React, Node.js, and Electron",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:electron": "wait-on http://localhost:3000 http://localhost:5000 && electron .",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "build:electron": "npm run build && electron-builder",
    "start": "electron .",
    "test": "npm run test --workspaces"
  },
  "build": {
    "appId": "com.sohailkhan.po-desktop",
    "productName": "Point of Sale Application",
    "files": [
      "electron/**/*",
      "packages/client/build/**/*",
      "packages/server/**/*",
      "!packages/server/uploads/**/*",
      "package.json",
      "database/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "packages/server/**/*",
      "packages/client/build/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "sohail & Rao",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^2.0.2"
  }
}