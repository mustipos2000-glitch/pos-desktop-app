{
  "name": "po-desktop",
  "version": "1.0.0",
  "description": "An application to manage point of sale",
  "main": "main.js",
  "scripts": {
    "start": "nodemon --ext js,html,css --exec electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "build":{
    "appId": "com.sohailkhan.po-desktop",
    "productName": "PO Desktop",
    "files": [
      "**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "sohail-khan",
  "license": "ISC",
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.10"
  }
}
