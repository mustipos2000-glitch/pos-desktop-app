{
  "name": "po-desktop-monorepo",
  "version": "1.0.0",
  "description": "POS Desktop Application - Monorepo with React, Node.js, and Electron",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:electron": "wait-on http://localhost:3000 http://localhost:5000 && electron .",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "build:electron": "npm run build && electron-builder",
    "start": "electron .",
    "test": "npm run test --workspaces"
  },
  "build": {
    "appId": "com.sohailkhan.po-desktop",
    "productName": "POS Desktop",
    "files": [
      "electron/**/*",
      "packages/client/build/**/*",
      "packages/server/dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "sohail-khan",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2"
  }
}
